# WorkOS AuthKit Configuration
# Retrieve these from your WorkOS Dashboard -> API Keys / AuthKit
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
# Random secret string with minimum 32 characters (e.g. generate with `openssl rand -base64 24`)
WORKOS_COOKIE_PASSWORD=your-secure-32-plus-character-cookie-password-here
WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_...

# Optional Supabase Cloud Database Configuration (for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
